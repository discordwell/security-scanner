# Security Scanner Configuration
# Copy to .env and modify as needed

# Database (PostgreSQL for production, SQLite for local dev)
# SCANNER_DATABASE_URL=postgresql+asyncpg://scanner:scanner@localhost:5432/scanner
# SCANNER_DATABASE_URL=sqlite+aiosqlite:///data/runtime/scanner.db

# Redis (for task queue)
# SCANNER_REDIS_URL=redis://localhost:6379

# Task queue (set to true to use arq background workers)
# SCANNER_USE_TASK_QUEUE=false

# Auth (set to true to require API key authentication)
# SCANNER_REQUIRE_AUTH=false

# Upload limits
# SCANNER_MAX_UPLOAD_BYTES=104857600

# CORS origins (comma-separated)
# SCANNER_CORS_ORIGINS=["*"]

# External tool paths
# SCANNER_GHIDRA_CMD=/opt/ghidra/support/analyzeHeadless
# SCANNER_CAPA_CMD=capa
# SCANNER_YARA_RULES_DIR=data/yara_rules

# Ghidra settings
# SCANNER_GHIDRA_TIMEOUT=300
# SCANNER_GHIDRA_MAX_FUNCTIONS=50

# Dynamic analysis (URLs to sandbox APIs)
# SCANNER_CAPE_CMD=http://cape-host:8000
# SCANNER_DRAKVUF_CMD=http://drakvuf-host:8080
